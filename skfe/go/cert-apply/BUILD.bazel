load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel:skia_app_container.bzl", "skia_app_container")
load("//bazel/go:go_test.bzl", "go_test")

skia_app_container(
    name = "cert-apply-container",
    base_image = "//kube/basealpine:basealpine",
    dirs = {
        "/usr/local/bin": [
            [
                "//skfe/go/cert-apply:cert-apply",
                "0755",
            ],
        ],
    },
    entrypoint = "/usr/local/bin/cert-apply",
    repository = "skia-public/cert-apply",
)

go_binary(
    name = "cert-apply",
    embed = [":cert-apply_lib"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "cert-apply_lib",
    srcs = ["main.go"],
    importpath = "go.skia.org/infra/skfe/go/cert-apply",
    visibility = ["//visibility:private"],
    deps = [
        "//go/cleanup",
        "//go/common",
        "//go/k8s",
        "//go/metrics2",
        "//go/secret",
        "//go/skerr",
        "//go/sklog",
        "//go/util",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
    ],
)

go_test(
    name = "cert-apply_test",
    srcs = ["main_test.go"],
    embed = [":cert-apply_lib"],
    deps = [
        "//go/k8s/mocks",
        "//go/metrics2",
        "//go/secret",
        "//go/secret/mocks",
        "@com_github_stretchr_testify//mock",
        "@com_github_stretchr_testify//require",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/runtime/schema",
    ],
)
