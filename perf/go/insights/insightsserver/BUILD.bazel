load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/go:go_test.bzl", "go_test")

go_library(
    name = "insightsserver_lib",
    srcs = [
        "access.go",
        "main.go",
        "server.go",
    ],
    importpath = "go.skia.org/infra/perf/go/insights/insightsserver",
    visibility = ["//visibility:private"],
    deps = [
        "//go/cleanup",
        "//go/metrics2",
        "//go/roles",
        "//go/skerr",
        "//go/sklog",
        "//perf/go/alerts",
        "//perf/go/builders",
        "//perf/go/config",
        "//perf/go/config/validate",
        "//perf/go/insights",
        "//perf/go/insights/localonly",
        "//perf/go/insights/mcptools",
        "//perf/go/insights/rest",
        "//perf/go/insights/site",
        "//perf/go/insights/tracereader",
        "//perf/go/urlprovider",
        "@com_github_go_chi_chi_v5//:chi",
        "@com_github_go_chi_chi_v5//middleware",
        "@org_golang_x_time//rate",
    ],
)

go_binary(
    name = "insightsserver",
    embed = [":insightsserver_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "insightsserver_test",
    srcs = [
        "access_test.go",
        "server_test.go",
    ],
    embed = [":insightsserver_lib"],
    deps = [
        "//perf/go/insights",
        "//perf/go/insights/site",
        "//perf/go/regression",
        "//perf/go/subscription/proto/v1",
        "@com_github_jackc_pgx_v4//:pgx",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
