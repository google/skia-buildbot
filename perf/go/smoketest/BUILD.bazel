load("@rules_go//go:def.bzl", "go_library")
load("//bazel/go:go_test.bzl", "go_test")

go_library(
    name = "smoketest_lib",
    srcs = ["checks.go"],
    importpath = "go.skia.org/infra/perf/go/smoketest",
    visibility = ["//visibility:private"],
    deps = ["//go/skerr"],
)

go_test(
    name = "smoketest_test",
    srcs = ["checks_test.go"],
    embed = [":smoketest_lib"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
