load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/go:go_test.bzl", "go_test")

go_library(
    name = "smoketest_lib",
    srcs = [
        "checks.go",
        "gate.go",
        "main.go",
        "verdict.go",
    ],
    importpath = "go.skia.org/infra/perf/go/smoketest",
    visibility = ["//visibility:private"],
    deps = [
        "//cd/go/stages",
        "//go/common",
        "//go/gcs",
        "//go/gcs/gcsclient",
        "//go/httputils",
        "//go/skerr",
        "@com_google_cloud_go_storage//:storage",
        "@org_golang_google_api//option",
        "@org_golang_x_oauth2//google",
    ],
)

go_binary(
    name = "perf-smoketest",
    embed = [":smoketest_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "smoketest_test",
    srcs = [
        "checks_test.go",
        "gate_test.go",
        "main_test.go",
        "verdict_test.go",
    ],
    embed = [":smoketest_lib"],
    deps = [
        "//go/gcs/mem_gcsclient",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
