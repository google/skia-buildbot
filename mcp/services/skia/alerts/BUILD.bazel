)

go_test(
    name = "alerts_test",
    srcs = ["client_test.go"],
    embed = [":alerts"],
    deps = [
        "//am/go/incident",
        "//am/go/incident/mocks",
        "//am/go/note",
        "//am/go/silence",
        "//am/go/silence/mocks",
