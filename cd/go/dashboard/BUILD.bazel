load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "dashboard_lib",
    srcs = ["main.go"],
    importpath = "go.skia.org/infra/cd/go/dashboard",
    visibility = ["//visibility:private"],
    deps = [
        "//cd/go/deployment_status",
        "//go/auth",
        "//go/docker",
        "//go/git/repograph",
        "//go/gitiles",
        "//go/gitstore/bt_gitstore",
