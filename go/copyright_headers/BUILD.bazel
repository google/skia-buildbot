go_test(
    name = "copyright_headers_test",
    srcs = ["copyright_headers_test.go"],
    embed = [":copyright_headers"],
    deps = [
        "//go/exec",
        "//go/git/git_common",
        "//go/testutils",
        "//go/vfs/mocks",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
