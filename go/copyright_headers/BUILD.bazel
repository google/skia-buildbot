load("@rules_go//go:def.bzl", "go_library")
load("//bazel/go:go_test.bzl", "go_test")

go_library(
    name = "copyright_headers",
    srcs = ["copyright_headers.go"],
    importpath = "go.skia.org/infra/go/copyright_headers",
    visibility = ["//visibility:public"],
    deps = [
        "//go/git",
        "//go/skerr",
        "//go/vfs",
