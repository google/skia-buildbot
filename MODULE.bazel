# Name the SDK downloaded from go.mod so that @go_sdk refers to it. Without a
# name, @go_sdk was mapped to rules_go's own "go_default_sdk", which follows
# the go directive in rules_go's go.mod (1.25.0), not ours. That SDK is what
# //bazel/go:go_toolchain_tar ships in container images.
